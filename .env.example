# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/selftaught

# Session / auth (nuxt-auth-utils) — generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-char-secret

# Separate session for apps/frontend (public site self-registration/login,
# Phase 19) -- deliberately its own secret, not shared with the admin app.
NUXT_FRONTEND_SESSION_PASSWORD=change-me-to-a-different-random-32-char-secret

# Media storage — path is relative to each app's own cwd (apps/admin, apps/frontend),
# which are both exactly two levels below the monorepo root, so "../../data/media"
# resolves to the SAME shared folder on disk for both apps.
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_PATH=../../data/media

# Site
NUXT_PUBLIC_SITE_URL=http://localhost:3001
