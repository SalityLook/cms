# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/selftaught

# Session / auth (nuxt-auth-utils) — generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-char-secret

# Media storage
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_PATH=./data/media

# Site
NUXT_PUBLIC_SITE_URL=http://localhost:3001
